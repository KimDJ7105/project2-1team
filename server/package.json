{
  "name": "augmented-gomoku-server",
  "version": "1.0.0",
  "description": "TypeScript Node.js Socket.io Server for Augmented Gomoku",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/app.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^5.2.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
