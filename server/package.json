{
  "name": "augmented-gomoku-server",
  "version": "1.0.0",
  "description": "TypeScript Node.js Socket.io Server for Augmented Gomoku",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/app.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "js-yaml": "^5.2.1",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.23.0",
    "redis": "^6.1.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "cross-env": "^10.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
